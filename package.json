{
  "name": "benkyou",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "勉強 Benkyō — a simple offline JLPT kanji & vocab drill PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
