ea","Foreign","Western Style"],"ex":[["彼らは大西洋を横断した。","They crossed the Atlantic Ocean.","洋"],["彼には洋々たる前途があった。","A brilliant future lay before him.","洋"],["東洋の陶器に興味があります。","I have an interest in oriental ceramics.","洋"]]},{"id":"旅","text":"旅","on":["リョ"],"kun":["たび"],"en":["Trip","Travel"],"ex":[["私費で旅行した。","I traveled at my own expense.","旅"],["彼は国中を旅した。","He traveled around the country.","旅"],["近頃は旅行は楽だ。","Travelling is easy these days.","旅"]]},{"id":"服","text":"服","on":["フク"],"kun":[],"en":["Clothing","Admit","Obey","Discharge"],"ex":[["一服いかがですか。","How about a smoke?","服"],["彼は公金を着服した。","He embezzled public money.","服"],["雨は服にしみ込んだ。","The rain soaked through my clothes.","服"]]},{"id":"夕","text":"夕","on":["セキ"],"kun":["ゆう"],"en":["Evening"],"ex":[["夕飯をせかせる。","Hurry in for supper.","夕"],["私は昨日夕飯を作った。","I cooked supper last night.","夕"],["彼とは夕食会で同席した。","I once sat at the same table with him at a dinner party.","夕"]]},{"id":"借","text":"借","on":["シャク"],"kun":["か.りる"],"en":["Borrow","Rent"],"ex":[["高金利で金を借りた。","We borrowed money at high interest.","借"],["彼は当日借り着をした。","He rented the garment for the day.","借"],["彼は借金をこしらえた。","He ran into debt.","借"]]},{"id":"曜","text":"曜","on":["ヨウ"],"kun":[],"en":["Weekday"],"ex":[["市は月曜ごとに立つ。","The market is held every Monday.","曜"],["再来週の木曜日はどう？","How about two weeks from Thursday?","曜"],["月曜日はいつも憂鬱だ。","I always feel blue on Mondays.","曜"]]},{"id":"飲","text":"飲","on":["イン","オン"],"kun":["の.む","-の.み"],"en":["Drink","Smoke","Take"],"ex":[["吐いた唾は飲めぬ。","A word, once out, flies everywhere.","飲"],["茶飲み友達がほしい。","I want someone to talk to.","飲"],["煮え湯を飲まされる。","He pushed it down my throat.","飲"]]},{"id":"肉","text":"肉","on":["ニク"],"kun":["しし"],"en":["Meat"],"ex":[["肉体は滅んでいく。","The flesh is mortal.","肉"],["肉に塩をかけよう。","I'll put some salt on the meat.","肉"],["私は肉食をやめた。","I've given up eating meat.","肉"]]},{"id":"貸","text":"貸","on":["タイ"],"kun":["か.す","か.し-","かし-"],"en":["Lend"],"ex":[["貸し金庫はありますか。","Do you have safety deposit boxes?","貸"],["金の貸借は友情の