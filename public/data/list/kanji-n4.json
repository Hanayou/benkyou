"彼は私と弟を取り違えた。","He mistook me for my younger brother.","弟"]]},{"id":"牛","text":"牛","on":["ギュウ"],"kun":["うし"],"en":["Cow"],"ex":[["水牛は牛に似ている。","A buffalo is akin to an ox.","牛"],["私は牛乳が飲みたいな。","I want to drink milk.","牛"],["彼は馬と牛を育てている。","He raises horses and cattle.","牛"]]},{"id":"魚","text":"魚","on":["ギョ"],"kun":["うお","さかな","-ざかな"],"en":["Fish"],"ex":[["大魚は小魚を食う。","The great fish eat the small.","魚"],["この魚は毒がない。","This fish is free from poison.","魚"],["水清ければ魚住まず。","Clear water breeds no fish.","魚"]]},{"id":"兄","text":"兄","on":["ケイ","キョウ"],"kun":["あに"],"en":["Elder Brother","Big Brother"],"ex":[["私の兄は教師です。","My older brother is a teacher.","兄"],["私の兄は大学生です。","My brother is a college student.","兄"],["私の兄は技師になった。","My brother became an engineer.","兄"]]},{"id":"犬","text":"犬","on":["ケン"],"kun":["いぬ","いぬ-"],"en":["Dog"],"ex":[["狂犬にご注意。","Look out for the wild dog!","犬"],["犬は四本足である。","A dog has four legs.","犬"],["犬を中へ連れ込むな。","Don't bring the dog in.","犬"]]},{"id":"妹","text":"妹","on":["マイ"],"kun":["いもうと"],"en":["Younger Sister"],"ex":[["私は妹に辞書をあげた。","I gave my sister a dictionary.","妹"],["今日は、妹の誕生日です。","Today is my sister's birthday.","妹"],["君の妹さんは何年生なの？","What grade is your sister in?","妹"]]},{"id":"姉","text":"姉","on":["シ"],"kun":["あね","はは"],"en":["Elder Sister"],"ex":[["姉はすごく頭がいい。","My sister has a very good brain.","姉"],["私の姉は君より背が低い。","My sister is shorter than you.","姉"],["姉の髪は肩まで届きます。","My sister's hair reaches to her shoulders.","姉"]]},{"id":"漢","text":"漢","on":["カン"],"kun":[],"en":["Sino-","China"],"ex":[["彼は大食漢だ。","He is a big eater.","漢"],["彼はその漢詩を肉太に書いた。","He wrote the Chinese poem in bold strokes.","漢"],["今日は漢字の書き取りがある。","We have a kanji dictation test today.","漢"]]}]}